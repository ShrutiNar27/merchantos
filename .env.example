DATABASE_URL="file:./dev.db"

# --- AI (optional) ---------------------------------------------------------
# If set, MerchantOS Agent uses real Claude tool-calling for reasoning.
# If unset, the agent runs in deterministic DEMO SIMULATION mode: the same
# real tool functions execute against real seeded data, but the decision of
# which tools to call follows a scripted, repeatable reasoning trace instead
# of a live LLM call. This keeps the hackathon demo reliable and repeatable.
ANTHROPIC_API_KEY=

# --- Razorpay TEST MODE (optional) -----------------------------------------
# If both are set, payments go through the real Razorpay Test Mode Orders API.
# If unset, payments run through a deterministic SIMULATED gateway adapter
# that implements the exact same state machine (see src/lib/payments/).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Forces the SIMULATED gateway's 1st payment attempt on every order to fail
# (every retry after that succeeds), so the failure/retry demo is repeatable.
# Only applies when RAZORPAY_KEY_ID/SECRET are unset. With real Razorpay Test
# Mode, use one of Razorpay's published test cards that always decline to
# demo the same failure/retry flow.
DEMO_FORCE_FIRST_ATTEMPT_FAILURE=true
